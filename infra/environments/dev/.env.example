# =============================================================================
# DEV environment configuration. Loaded as TF_VAR_* by ./tf.sh (or `make`).
# Complex values (lists/maps) are JSON, single-quoted so the shell keeps them.
# Do NOT commit real secrets — keep app_secret_value out of version control.
# =============================================================================

# --- Identity ---------------------------------------------------------------
TF_VAR_project=alphapro
TF_VAR_environment=dev
TF_VAR_aws_region=ap-southeast-1

# --- AWS auth ---------------------------------------------------------------
# Named profile Terraform authenticates with. tf.sh does `set -a` before
# sourcing this file, so plain (non-TF_VAR_) variables like this one are
# exported to the AWS SDK too. Machine-specific, and .env is git-ignored —
# change it freely if your local profile is named differently.
AWS_PROFILE=alpha-pro-ap-southeast-1

# --- Networking -------------------------------------------------------------
TF_VAR_vpc_cidr=10.0.0.0/16
TF_VAR_public_subnet_cidrs='["10.0.0.0/24","10.0.1.0/24"]'
TF_VAR_private_subnet_cidrs='["10.0.2.0/24","10.0.3.0/24"]'
TF_VAR_enable_quicksight_access=true
TF_VAR_allowed_db_cidrs='["103.244.176.6/32","110.93.203.98/32","110.93.203.100/32","110.93.230.236/32","182.190.201.67/32","202.69.48.87/32","202.69.53.151/32","43.246.227.64/27","43.246.227.66/32"]'
# false = 1 NAT Gateway, 1 static egress IP shared by every ECS service, no AZ
# redundancy. true = 1 NAT Gateway per AZ, N static IPs, AZ-redundant egress.
TF_VAR_nat_gateway_multi_az=false

# --- Compute (ECS Fargate) --------------------------------------------------
TF_VAR_container_image=330929085533.dkr.ecr.ap-southeast-1.amazonaws.com/squatwolf/staging/alphapro:latest
TF_VAR_infra_release_version=20260522-112611
# Must match how the Docker image was actually built:
#   Apple Silicon Mac -> ARM64 | Intel Mac / GitHub Actions runner -> X86_64
# A mismatch fails silently: plan+apply succeed, then every task dies with
# "exec format error". Change this the day the build moves to CI.
TF_VAR_container_cpu_architecture=ARM64
# The live dev stack runs all 7 services 100% on Fargate Spot.
TF_VAR_capacity_provider_strategy='[{"capacity_provider":"FARGATE_SPOT","base":1,"weight":1}]'
TF_VAR_deployment_maximum_percent=200
TF_VAR_deployment_minimum_healthy_percent=100
TF_VAR_task_cpu=256
TF_VAR_task_memory=512
TF_VAR_web_port=8000
TF_VAR_web_desired_count=1
TF_VAR_web_min_capacity=1
TF_VAR_web_max_capacity=10
# Set false to stand the stack up without running consumers.
# Python module each consumer runs. One queue per store now, so it receives
# all three webhook topics and dispatches on X-Shopify-Topic itself.
TF_VAR_consumer_module=app.workers.sqs_consumer
# Master switch for all consumers — one per store now, not one per store and
# queue type. Per-store control is consumer_enabled in stores.auto.tfvars.
# False destroys the services; the queues and rules stay, so webhooks keep
# accumulating rather than being dropped.
TF_VAR_enable_consumers=true
TF_VAR_consumer_desired_count=1
TF_VAR_consumer_min_capacity=1
TF_VAR_consumer_max_capacity=5
TF_VAR_autoscaling_cpu_target=70
# HTTPS. Leave empty for HTTP-only. Paste an ACM certificate ARN issued in
# TF_VAR_aws_region (ap-southeast-1 — NOT us-east-1, that rule is CloudFront's)
# and apply: a 443 listener appears, port 80 becomes a 301 redirect to it, and
# 443 opens on the ALB security group. Terraform does not request the cert —
# issue and validate it in ACM first.
# Redirect port 80 -> 443. Off here: port 80 keeps serving the app directly,
# with HTTPS available alongside rather than enforced.
TF_VAR_alb_http_redirect_to_https=true
TF_VAR_acm_certificate_arn=
TF_VAR_health_check_timeout=10
TF_VAR_web_health_check_grace_period=60
TF_VAR_container_insights=true
# Circuit breaker OFF in dev. Deployments retry indefinitely, which is what
# you want while debugging a task that will not start.
TF_VAR_enable_deployment_circuit_breaker=false

# --- Frontend (SPA on the SAME ALB, added as a listener rule) ---------------
# Empty image = frontend off entirely. Setting it adds:
#   frontend_host_header -> frontend  (listener rule on 80 and 443, priority 100)
# The backend is NOT touched: the listener default action still forwards every
# other host to it, exactly as today.
TF_VAR_frontend_container_image=
# Hostname the SPA is served on. Must resolve to this ALB in Cloudflare AND be
# covered by the certificate. Keep it distinct from the backend's hostname.
TF_VAR_frontend_host_header=dash-dev.alfapro.ai
# Architecture of the FRONTEND image specifically. Empty inherits
# container_cpu_architecture (the backend's). Set separately because the two
# images live in different repos and are built by different pipelines — a
# mismatch fails at task start with "image Manifest does not contain
# descriptor matching platform 'linux/arm64 v8'".
TF_VAR_frontend_cpu_architecture=
TF_VAR_frontend_port=3000
TF_VAR_frontend_health_check_path=/
TF_VAR_frontend_desired_count=1
TF_VAR_frontend_min_capacity=1
TF_VAR_frontend_max_capacity=4
# CAUTION: Vite inlines VITE_* at BUILD time (`vite build` substitutes them
# into the bundle). For a pre-built SPA served by nginx these do NOTHING at
# runtime — they must be --build-arg values when the image is built. Kept here
# because some nginx SPA images template a runtime config from the environment.
TF_VAR_frontend_env='{"VITE_API_URL":"https://app-dev.alfapro.ai","VITE_APP_NAME":"Alphapro OMS","VITE_APP_ENV":"staging","VITE_MOCK_AUTH":"false"}'

# --- Application settings (web container) ------------------------------------
# Merged on top of the variables the module derives itself. APP_ENV is
# deliberately absent — ENVIRONMENT already carries dev/prod, and the module
# sets it from TF_VAR_environment.
# ALLOWED_HEADERS is * on purpose. The raw CORS spec excludes Authorization
# from the wildcard, but Starlette/FastAPI implements * by ECHOING back
# whatever the browser asked for, so it covers Authorization and any custom
# header the SPA adds. An explicit list 400s the preflight the moment the
# SPA sends a header nobody remembered to add here.
# ALLOWED_ORIGINS lists who may CALL this API — the FRONTEND's origin, not
# the backend's own URL (same-origin requests never trigger CORS).
# SECRET_KEY is NOT here — it signs JWTs, so it lives in the app secret
# (alphapro/<env>/app, key: secret_key) and is injected from there.
TF_VAR_web_env='{"APP_NAME":"AlphaPro_v1.0","APP_DESCRIPTION":"Integration_Layer","APP_VERSION":"0.1.0","DEBUG":"false","ALGORITHM":"HS256","ACCESS_TOKEN_EXPIRE_MINUTES":"30","ALLOWED_ORIGINS":"https://dash-dev.alfapro.ai,http://localhost:3000,http://localhost:5173","ALLOWED_METHODS":"GET,POST,PUT,PATCH,DELETE,OPTIONS","ALLOWED_HEADERS":"*"}'

# --- Stores (Shopify integration) -------------------------------------------
TF_VAR_shopify_sqs_strict_hmac=false
TF_VAR_sqs_receive_wait_time_seconds=20
# Celery's own SQS queue. Off in dev — Celery uses the Redis broker here.
TF_VAR_enable_celery_queue=false
# Celery worker tasks. 0 pauses it; only applies when the queue is enabled.
# Beat is a singleton — 1 or 0, never more.
TF_VAR_celery_beat_desired_count=1
TF_VAR_celery_worker_desired_count=1
# alphapro/dev/database has no MONGODB_URL key — leave off until it does.
TF_VAR_enable_mongodb=false
# app_url: one shared value per environment — every consumer calls back into
# the same running web service, regardless of which store it's processing.
TF_VAR_app_url=https://it-dev.alfapro.ai/
# Store definitions (name, per-queue-type event buses) are NOT here.
# See stores.auto.tfvars.example in this directory — one block per store,
# loaded automatically by Terraform. Add a new store there, not as JSON here.

# --- Database (RDS PostgreSQL) ----------------------------------------------
# Leave db_host empty: Terraform creates and owns the RDS instance, including
# generating the master username/password and storing them in Secrets Manager.
# Only set db_host if you're deliberately reusing a database Terraform doesn't
# manage yet — and in that case, prefer `terraform import` instead so the real
# instance ends up under management rather than permanently unmanaged.
TF_VAR_db_host=
# Major-only: RDS resolves to its current latest 18.x minor at creation.
TF_VAR_db_engine_version=18
TF_VAR_db_instance_class=db.t3.micro
TF_VAR_db_allocated_storage=20
TF_VAR_db_max_allocated_storage=100
TF_VAR_db_name=alphapro
TF_VAR_db_username=alphapro_admin
TF_VAR_db_port=5432
TF_VAR_db_multi_az=false
# 7-day automated backup retention -> RDS takes a daily automated snapshot,
# each kept for 7 days.
TF_VAR_db_backup_retention_period=7
TF_VAR_db_deletion_protection=true
TF_VAR_db_skip_final_snapshot=true
TF_VAR_db_publicly_accessible=true

# --- Cache (ElastiCache Valkey) ---------------------------------------------
TF_VAR_valkey_node_type=cache.t3.micro
TF_VAR_valkey_engine_version=8.0
TF_VAR_valkey_num_cache_clusters=1
TF_VAR_valkey_automatic_failover=false
TF_VAR_broker_port=6379
TF_VAR_cache_port=6380

# --- Storage (S3 assets) -----------------------------------------------------
# Must be globally unique across all of AWS. If this exact bucket already
# exists (e.g. created manually before adding this variable), import it
# instead of letting Terraform try to create it:
#   terraform import 'module.alphapro.aws_s3_bucket.assets' <bucket-name>
# Public assets: sitemaps and feeds, served through CloudFront with Origin
# Access Control. The bucket itself stays fully private — CloudFront is the
# only principal its policy admits. Empty bucket name disables all of it.
TF_VAR_public_assets_bucket_name=squatwolf-alphapro-dev-public
# Hostname for the public assets. Each store writes under its own prefix, so
# a sitemap lands at <host>/<store>/sitemap.xml.
TF_VAR_public_assets_host=
# Certificate for that hostname. MUST be in us-east-1 — CloudFront reads
# certificates from no other region, so the ap-southeast-1 one this stack
# uses for its ALB cannot be reused. Empty = *.cloudfront.net domain.
TF_VAR_public_assets_certificate_arn=
TF_VAR_s3_bucket_name=squatwolf-alphapro-dev-files

# --- API docs ---------------------------------------------------------------
# Serve the API documentation endpoint. Plain config, not a credential — the
# basic-auth pair guarding it lives in the app secret (docs_username /
# docs_password) and is injected into the web container from there.
TF_VAR_docs_enabled=false

# --- Secrets (supply real Shopify creds out-of-band) ------------------------
# One secret holds every credential the app itself owns: Shopify keys and the
# API docs basic-auth pair. Seeded as {} here and filled in the Secrets Manager
# console at alphapro/<env>/app — the version carries ignore_changes, so
# applies never overwrite what you set there.
# Keys the web task reads by name: docs_username, docs_password
TF_VAR_app_secret_value='{}'

# --- Observability ----------------------------------------------------------
TF_VAR_log_retention_days=30
TF_VAR_alarm_email=muzammal.saeed@squatwolf.com
TF_VAR_alarm_queue_depth_threshold=1000
